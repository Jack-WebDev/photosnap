---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import StoryCard from "../_components/StoryCard";
---

<BaseLayout title="Stories">
  <div
    class="flex flex-col justify-center bg-[url('/stories/mobile/moon-of-appalacia.jpg')] md:bg-[url('/stories/tablet/moon-of-appalacia.jpg')] lg:bg-[url('/stories/desktop/moon-of-appalacia.jpg')] bg-cover bg-center bg-no-repeat h-[28vh] md:h-[67vh] lg:h-[80vh] w-full pl-40 gap-4"
  >
    <p class="text-white uppercase mb-12 hidden lg:inline-block">Last Month&apos;s Feature Story</p>
    <h1 class="text-white hidden lg:inline-block lg:text-7xl">
      HAZY FULL <br /> MOON OF <br /> APPALACHIA
    </h1>
    <p class="text-white/65 hidden lg:inline-block">
      March 2nd 2020 <span class="text-white">by John Appleseed</span>
    </p>
    <p class="w-[50ch] text-white/65 hidden lg:inline-block">
      The dissected plateau area, while not actually made up of geological
      mountains, is popularly called "mountains," especially in eastern Kentucky
      and West Virginia, and while the ridges are not high, the terrain is
      extremely rugged.
    </p>
    <a href="#" class=" gap-6 text-white hidden lg:flex"
      ><span> READ THE STORY</span>
      <Image
        src="/shared/desktop/arrow-white.svg"
        alt="arrow"
        width="70"
        height="100"
      /></a
    >
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 w-full">
    <StoryCard
      creator="Samantha Brooke"
      date="April 9th 2020"
      title="Architecturals"
      desktopBackgroundImage="/stories/desktop/architecturals.jpg"
      mobileBackgroundImage="/stories/mobile/architecturals.jpg"
      client:load
    />
    <StoryCard
      creator="Mohammed Abdul"
      date="March 19th 2020"
      title="Rage of The Sea"
      desktopBackgroundImage="/stories/desktop/rage-of-the-sea.jpg"
      mobileBackgroundImage="/stories/mobile/rage-of-the-sea.jpg"
      client:load
    />

    <StoryCard
      creator="Lamarr Wilson"
      date="March 11th 2020"
      title="Behind the Waves"
      desktopBackgroundImage="/stories/desktop/behind-the-waves.jpg"
      mobileBackgroundImage="/stories/mobile/behind-the-waves.jpg"
      client:load
    />
    <StoryCard
      creator="Timothy Wagner"
      date="April 7th 2020"
      title="World Tour 2019"
      desktopBackgroundImage="/stories/desktop/mountains.jpg"
      mobileBackgroundImage="/stories/mobile/mountains.jpg"
      client:load
    />
    <StoryCard
      creator="William Malcolm"
      date="April 3th 2020"
      title="Unforeseen Corners"
      desktopBackgroundImage="/stories/desktop/unforeseen-corners.jpg"
      mobileBackgroundImage="/stories/mobile/unforeseen-corners.jpg"
