---
import { Image } from "astro:assets";
---

<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 w-full">
  <div
    class="flex flex-col justify-end items-center bg-[url('/stories/mobile/calm-waters.jpg')] lg:bg-[url('/stories/desktop/calm-waters.jpg')] bg-cover bg-center bg-no-repeat h-[32vh] w-full"
  >
    <div class="w-full px-8 py-8">
      <div
        class="text-start text-white w-full border-b border-white/70 pb-4 mb-4"
      >
        <h2 class="text-2xl font-semibold">Calm Waters</h2>
        <span>by Samantha Brooke</span>
      </div>
      <a
        href="#"
        class="tracking-wider flex items-center gap-4 justify-between w-full"
      >
        <span class="text-white font-semibold">READ STORY</span>
        <Image
          src="/shared/desktop/arrow-white.svg"
          alt="arrow"
          width="70"
          height="100"
        />
      </a>
    </div>
  </div>
  <div
    class="flex flex-col justify-end items-center bg-[url('/stories/mobile/cityscapes.jpg')] lg:bg-[url('/stories/desktop/cityscapes.jpg')] bg-cover bg-center bg-no-repeat h-[32vh] w-full"
  >
    <div class="w-full px-8 py-8">
      <div
        class="text-start text-white w-full border-b border-white/70 pb-4 mb-4"
      >
        <h2 class="text-2xl font-semibold">Sunset Cityscapes</h2>
        <span>by Benjamin Cruz</span>
      </div>
      <a
        href="#"
        class="tracking-wider flex items-center gap-4 justify-between w-full"
      >
        <span class="text-white font-semibold">READ STORY</span>
        <Image
          src="/shared/desktop/arrow-white.svg"
          alt="arrow"
          width="70"
          height="100"
        />
      </a>
    </div>
  </div>
  <div
    class="flex flex-col justify-end items-center bg-[url('/stories/mobile/milky-way.jpg')] lg:bg-[url('/stories/desktop/milky-way.jpg')] bg-cover bg-center bg-no-repeat h-[32vh] w-full"
  >
    <div class="w-full px-8 py-8">
      <div
        class="text-start text-white w-full border-b border-white/70 pb-4 mb-4"
      >
        <h2 class="text-2xl font-semibold">The Milky Way</h2>
        <span>by Benjamin Cruz</span>
      </div>
      <a
        href="#"
        class="tracking-wider flex items-center gap-4 justify-between w-full"
      >
        <span class="text-white font-semibold">READ STORY</span>
        <Image
          src="/shared/desktop/arrow-white.svg"
          alt="arrow"
          width="70"
          height="100"
        />
      </a>
    </div>
  </div>
  <div
    class="flex flex-col justify-end items-center bg-[url('/stories/mobile/land-of-dreams.jpg')] lg:bg-[url('/stories/desktop/land-of-dreams.jpg')] bg-cover bg-center bg-no-repeat h-[32vh] w-full"
  >
    <div class="w-full px-8 py-8">
      <div
        class="text-start text-white w-full border-b border-white/70 pb-4 mb-4"
      >
        <h2 class="text-2xl font-semibold">Land of Dreams</h2>
        <span>by William Malcolm</span>
      </div>
      <a
        href="#"
        class="tracking-wider flex items-center gap-4 justify-between w-full"
      >
        <span class="text-white font-semibold">READ STORY</span>
        <Image
          src="/shared/desktop/arrow-white.svg"
          alt="arrow"
          width="70"
          height="100"
        />
      </a>
    </div>
  </div>
</section>
