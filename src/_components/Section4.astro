---
import { Image } from "astro:assets";
---

<section class="grid grid-cols-1 lg:grid-cols-3 w-full my-8 gap-6">
  <div class="flex flex-col justify-center items-center text-center gap-4">
    <Image
      src="/features/desktop/responsive.svg"
      alt="hero"
      width="100"
      height="100"
      class="w-1/6"
    />
    <div>
      <h2 class="text-2xl font-semibold mb-4">100% Responsive</h2>
      <p class="mx-4 md:w-[50ch] lg:w-[25ch]">
        No matter which the device you're on, our site is fully responsive and
        stories look beautiful on any screen.
      </p>
    </div>
  </div>
  <div class="flex flex-col justify-center items-center text-center gap-4">
    <Image
      src="/features/desktop/embed.svg"
      alt="hero"
      width="100"
      height="100"
      class="w-1/6"
    />
    <div>
      <h2 class="text-2xl font-semibold mb-4">Available to Embed</h2>
      <p class="mx-4 md:w-[50ch] lg:w-[25ch]">
        Embed Tweets, Facebook posts, Instagram media, Vimeo or Youtube videos,
        Google Maps, and more.
      </p>
    </div>
  </div>
  <div class="flex flex-col justify-center items-center text-center gap-4">
    <Image
      src="/features/desktop/no-limit.svg"
      alt="hero"
      width="100"
      height="100"
      class="w-1/6"
    />
    <div>
      <h2 class="text-2xl font-semibold mb-4">No Photo Upload Limit</h2>
      <p class="mx-4 md:w-[50ch] lg:w-[25ch]">
        Our tool has no limits on uploads or bandwidth. Freely upload in bulk
        and share all of your stories in one go.
      </p>
    </div>
  </div>
</section>
