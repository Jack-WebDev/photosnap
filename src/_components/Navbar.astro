---
import { Image } from "astro:assets";
---

<nav class="flex items-center justify-between md:justify-around p-4">
  <a href="/" class="flex items-center">
    <Image src="/shared/desktop/logo.svg" alt="logo" width="200" height="200" />
  </a>

  <div class="hamburger__menu md:hidden" id="hamburgerMenu" aria-hidden="true">
    <Image
      class="hamburger"
      src="/shared/mobile/menu.svg"
      alt="menu"
      width="20"
      height="20"
      id="hamburger"
    />
    <Image
      class="close__menu"
      src="/shared/mobile/close.svg"
      alt="close"
      width="20"
      height="20"
      id="closeMenu"
    />
  </div>
  <ul
    class="md:flex translate-y-[150%] items-center gap-4 nav__menu bg-none"
    id="navMenu"
  >
    <li><a href="/stories">STORIES</a></li>
    <li><a href="/features">FEATURES</a></li>
    <li><a href="/pricing">PRICING</a></li>
  </ul>

  <button
    class="text-white bg-black rounded-md py-2 px-6 cursor-pointer hidden md:inline-block"
  >
    GET AN INVITE
  </button>
</nav>

<style>
  .nav__menu {
    display: grid;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background-color: #fff;
    width: 90%;
    position: absolute;
    left: 5%;
    top: 0;
    padding-block: 1rem;
    transform: translateY(-250%);
    transition: transform 300ms ease-in-out;
  }

  .hamburger__menu {
    position: absolute;
    right: 5%;
    cursor: pointer;
  }
  .hamburger__menu .hamburger {
    position: absolute;
  }
  .hamburger__menu .close__menu {
    opacity: 0;
  }
  .nav__menu.active {
    transform: translateY(-50%);
  }

  .nav__menu.active {
    transform: translateY(-50%);
  }
  .hamburger__menu .close__menu.active {
    opacity: 1;
    z-index: 999;
  }
  .hamburger__menu > .hamburger.active {
    opacity: 0;
  }

  .hamburger__menu .close__menu.active {
    opacity: 1;
    z-index: 999;
  }

  .hamburger__menu > .hamburger.active {
    opacity: 0;
  }
  @media screen and (min-width: 768px) {
    .nav__menu {
      display: flex;
      width: auto;
      position: unset;
      padding: unset;
      background-color: unset;
      transform: translateY(-35px);
      box-shadow: none;
    }
  }
</style>

<script>
  const navMenu = document.getElementById("navMenu");
  const hamburgerMenu = document.getElementById("hamburgerMenu");
  const closeMenu = document.getElementById("closeMenu");
  const hamburger = document.getElementById("hamburger");

  hamburgerMenu?.addEventListener("click", () => {
    navMenu?.classList.toggle("active");
    closeMenu?.classList.toggle("active");
    hamburger?.classList.toggle("active");
  });
</script>
