---
import { Image } from "astro:assets";
---

<section class="flex flex-col-reverse md:flex-row items-stretch w-full">
  <div
    class="flex-1 bg-black text-white md:flex md:flex-col md:justify-center md:items-center lg:items-baseline"
  >
    <div
      class="bg-gradient-to-r from-[#5EA6FF] via-[#C471ED] to-[#FAD27A] h-[5px] w-1/2 md:hidden mx-auto"
    >
    </div>

    <div
      class="relative my-12 px-8 lg:pl-32 grid gap-y-4 w-full
         before:content-[''] before:absolute before:left-0 before:top-0 before:bottom-0
         before:w-[5px] before:hidden md:before:block
         before:bg-gradient-to-b
         before:from-[#5EA6FF] before:via-[#C471ED] before:to-[#FAD27A]"
    >
      <h1 class="text-2xl md:text-5xl font-semibold tracking-wide text-center md:text-start">
        CREATE AND <br /> SHARE YOUR <br /> PHOTO STORIES.
      </h1>

      <p class="text-sm text-white/70 lg:w-[50ch] text-center md:text-start">
        Photosnap is a platform for photographers and visual storytellers. We
        make it easy to share photos, tell stories and connect with others.
      </p>

      <a href="#" class="tracking-wider flex items-center gap-4 justify-center md:justify-start">
        GET AN INVITE
        <Image
          src="/shared/desktop/arrow-white.svg"
          alt="arrow"
          width="70"
          height="100"
        />
      </a>
    </div>
  </div>

  <div class="lg:flex-1/6">
    <Image
      src={"/home/desktop/create-and-share.jpg"}
      alt="hero"
      width="100"
      height="100"
      class="hidden lg:inline-block w-full h-full"
    />
    <Image
      src={"/home/tablet/create-and-share.jpg"}
      alt="hero"
      width="100"
      height="100"
      class="hidden md:inline-block lg:hidden w-full h-full"
    />
    <Image
      src={"/home/mobile/create-and-share.jpg"}
      alt="hero"
      width="100"
      height="100"
      class="md:hidden w-full h-full"
    />
  </div>
</section>
