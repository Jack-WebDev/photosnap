---
import FeatureCard from "./FeatureCard";
---

<section
  class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-4 max-w-7xl mx-auto p-8 items-center lg:h-[100vh]"
>
  <FeatureCard
    title="100% Responsive"
    description="No matter which the device you're on, our site is fully responsive and stories look beautiful on any screen."
    image="/features/desktop/responsive.svg"
  />
  <FeatureCard
    title="No Photo Upload Limit"
    description="Our tool has no limits on uploads or bandwidth. Freely upload in bulk and share all of your stories in one go."
    image="/features/desktop/no-limit.svg"
  />
  <FeatureCard
    title="Available To Embed"
    description="Embed Tweets, Facebook posts, Instagram media, Vimeo or Youtube videos, Google Maps, and more."
    image="/features/desktop/embed.svg"
  />
  <FeatureCard
    title="Custom Domain"
    description="With Photosnap subscriptions you can host your stories on your own domain. You can also remove our branding!"
    image="/features/desktop/custom-domain.svg"
  />
  <FeatureCard
    title="Boost Your Exposure"
    description="Users that viewed your story or gallery can easily get notified of new and featured stories with our built in mailer list."
    image="/features/desktop/boost-exposure.svg"
  />
  <FeatureCard
    title="Drag & Drop Image"
    description="Easily drag and drop you image and get beautiful shot everytime. No over the top tooling to add friction to creating stories."
    image="/features/desktop/drag-drop.svg"
  />
</section>
