---
import { Image } from "astro:assets";
---

<section class="flex flex-col-reverse md:flex-row items-stretch w-full">
  <div
    class="bg-black text-white md:flex md:flex-col md:justify-center md:items-center lg:items-baseline md:flex-1/6 lg:flex-0"
  >
    <div class="py-4 px-8 grid gap-4">
      <h1
        class="text-2xl md:text-5xl font-semibold tracking-wide text-center md:text-start"
      >
        FEATURES
      </h1>

      <p class="text-sm text-white/70 lg:w-[50ch] text-center md:text-start">
        We make sure all of our features are designed to be loved by every
        aspiring and even professional photographers who wanted to share their
        stories.
      </p>
    </div>
  </div>

  <div class="md:flex-1 lg:flex-1">
    <Image
      src={"/features/desktop/hero.jpg"}
      alt="hero"
      width="100"
      height="100"
      class="hidden lg:inline-block w-full h-full"
    />
    <Image
      src={"/features/tablet/hero.jpg"}
      alt="hero"
      width="100"
      height="100"
      class="hidden md:inline-block lg:hidden w-full h-full"
    />
    <Image
      src={"/features/mobile/hero.jpg"}
      alt="hero"
      width="100"
      height="100"
      class="md:hidden w-full h-full"
    />
  </div>
</section>
